Windows Registry Editor Version 5.00

; Associates .map files with DDNet Map Control (current user only)
; Safe: writes to HKCU (no admin required). To revert, you can delete these keys.

[HKEY_CURRENT_USER\Software\Classes\.map]
@="DDNetMapFile"

[HKEY_CURRENT_USER\Software\Classes\DDNetMapFile]
@="DDNet Map File"

[HKEY_CURRENT_USER\Software\Classes\DDNetMapFile\DefaultIcon]
@="C:\\Users\\rust-\\CascadeProjects\\ddnetcontrol\\Image\\ddnet-unstable.ico"

[HKEY_CURRENT_USER\Software\Classes\DDNetMapFile\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\DDNetMapFile\shell\open]
@="Open"

[HKEY_CURRENT_USER\Software\Classes\DDNetMapFile\shell\open\command]
@="\"C:\\Users\\rust-\\CascadeProjects\\ddnetcontrol\\ddnet_control.exe\" \"%1\""
